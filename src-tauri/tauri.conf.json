{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Memories Desktop",
  "version": "1.0.0",
  "identifier": "com.minec.memories",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Memories Desktop",
        "width": 1024,
        "height": 768,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Duck-dev-05/memoriesdesktopapplication/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYzODY4N0MxMTE2MzA4MwpSV1NETUJZUmZHZzREN1kzTHEvV1BCdDhpY002em5UcXRXMzJ3czNLZ2dSOHJ5TjROL1hpamw0Rgo="
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Minec",
    "shortDescription": "Memories photo management application",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "license": "license.txt",
    "macOS": {
      "minimumSystemVersion": "10.13"
    },
    "windows": {
      "minimumWebview2Version": "1.0.0",
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": true,
        "startMenuFolder": "Memories Desktop",
        "installerHooks": "hooks.nsh"
      }
    }
  }
}
